{
  "multipart": [
    { "when": { "level": "3|2|1|0", "food_type": "empty|fish|fruit|grain|insects|leaves|meat|veggie" },
      "apply": { "model": "zawa:block/metal_trough" }
    },

    { "when": { "level": "3|2|1|0", "food_type": "fish" },
      "apply": { "model": "zawa:block/metal_trough_fish" }
    },
    { "when": { "level": "3|2|1|0", "food_type": "fruit" },
      "apply": { "model": "zawa:block/metal_trough_fruit" }
    },
    { "when": { "level": "3|2|1|0", "food_type": "grain" },
      "apply": { "model": "zawa:block/metal_trough_grain" }
    },
    { "when": { "level": "3|2|1|0", "food_type": "insects" },
      "apply": { "model": "zawa:block/metal_trough_insects" }
    },
    { "when": { "level": "3|2|1|0", "food_type": "leaves" },
      "apply": { "model": "zawa:block/metal_trough_leaves" }
    },
    { "when": { "level": "3|2|1|0", "food_type": "meat" },
      "apply": { "model": "zawa:block/metal_trough_meat" }
    },
    { "when": { "level": "3|2|1|0", "food_type": "veggie" },
      "apply": { "model": "zawa:block/metal_trough_veggie" }
    },

    { "when": { "level": "3|2|1", "food_type": "empty" },
      "apply": { "model": "zawa:block/metal_trough_water" }
    }
  ]
}
