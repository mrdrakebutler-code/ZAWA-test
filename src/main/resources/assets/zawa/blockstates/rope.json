{
  "multipart": [
    {
      "when": {
        "attached": "true"
      },
      "apply": {
        "model": "zawa:block/rope_knot"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "zawa:block/rope"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "zawa:block/rope",
        "x": 180
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "zawa:block/rope",
        "x": 90
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "zawa:block/rope",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "zawa:block/rope",
        "x": 270
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "zawa:block/rope",
        "x": 270,
        "y": 90
      }
    }
  ]
}